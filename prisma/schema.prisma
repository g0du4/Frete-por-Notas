generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model itens {
  id              Int           @id @default(autoincrement())
  item            String
  qtdOriginal     Int?
  unMedida        String?
  qtdcx           Int?
  peso            Float?
  precoCobrado    Float?   
  temExcecao      Boolean @default(false)
  tipoCalculoItem String
  nNf             Int  
  notaFiscalId    String  
  notas_fiscais   notas_fiscais @relation(fields: [notaFiscalId], references: [id])
}

model notas_fiscais {
  id             String   @id @default(cuid())
  data           DateTime
  nNF            Int
  totalCx        Int      @default(0)
  pesoKg         Float    @default(0)
  frete          Float
  freteUnitKg    Float?
  freteUnitCx    Float?
  fonte          String?
  destinatario   String?
  destCNPJ       String
  valorNF        Float?
  transportadora String?
  itens          itens[]
}
